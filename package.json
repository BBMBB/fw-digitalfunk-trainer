{
  "name": "digitalfunk-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch backend/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/backend/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "24.10.0",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0"
  }
}
